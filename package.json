  "type": "module",
  "license": "MIT",
  "repository": "github:psmfd/pi-bash-destructive-guard",
  "keywords": [
    "pi",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.75"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "^25.9.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
